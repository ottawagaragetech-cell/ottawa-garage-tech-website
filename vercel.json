{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/reviews",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/reviews.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ottawagaragetech.ca" }],
      "destination": "https://ottawagaragetech.ca/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ottawa-garage-tech-website.vercel.app" }],
      "destination": "https://ottawagaragetech.ca/:path*",
      "permanent": true
    }
  ]
}
